# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Community Cloud > App settings > Secrets.
# Only needed to turn on "Sign in with Google". Without it the app just runs with no sign-in, saved on this device.
# NEVER commit the real secrets.toml.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"        # hosted: https://YOUR-APP.streamlit.app/oauth2callback
cookie_secret = "PASTE-A-LONG-RANDOM-STRING"                  # python -c "import secrets; print(secrets.token_urlsafe(32))"
client_id = "PASTE-YOUR-CLIENT-ID.apps.googleusercontent.com"
client_secret = "PASTE-YOUR-CLIENT-SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
expose_tokens = "access"                                      # lets the app save to the person's Drive
client_kwargs = { scope = "openid email profile https://www.googleapis.com/auth/drive.appdata" }

# Optional extras (shared by everyone):
# GIPHY_API_KEY = "..."    # fun G-rated GIFs between sets (free key: developers.giphy.com)
# GEMINI_API_KEY = "..."   # AI for everyone, from your key (stays on the server); without it people paste their own
# AI_DAILY_LIMIT = "20"     # AI requests per person per day on your key
# EDAMAM_APP_ID = "..."
# EDAMAM_APP_KEY = "..."
