# Copy to .env (or just run `python run.py`, which creates it for you).
# Every value is optional; features without a key show a hint instead.

# Gemini: AI workout plans, AI meal plans, gym machine guide
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Requests per person per day on this key (default 20)
# AI_DAILY_LIMIT=20
# GEMINI_MODEL=gemini-2.5-flash

# GIPHY: fun G-rated GIFs between sets and at the finish (free key: https://developers.giphy.com/)
GIPHY_API_KEY=

# Edamam Recipe Search API: recipe search
# Free: https://developer.edamam.com/
EDAMAM_APP_ID=
EDAMAM_APP_KEY=

# --- Database --------------------------------------------------------------
# Default is a local SQLite file in ./data (nothing to set up).
# To use the original BigQuery database instead:
#   pip install -r requirements-bigquery.txt
# BODYSYNC_DB=bigquery
# GCP_PROJECT_ID=your-gcp-project
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# BQ_DATASET=bodysyncusers

# Where the local database and exercise images live (default: ./data)
# BODYSYNC_DATA_DIR=
